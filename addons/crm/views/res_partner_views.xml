<?xml version="1.0"?>
<odoo>

    <record id="view_partner_form_crm_person" model="ir.ui.view">
        <field name="name">res.partner.form.crm.person</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Contacto" class="o_crm_partner_form o_crm_partner_contact_form">
                <sheet>
                    <field name="is_company" invisible="1"/>
                    <field name="type" invisible="1"/>

                    <group string="INFORMACIÓN DE CONTACTO" col="2">
                        <group>
                            <field name="first_name" required="1" placeholder="Ej: Juan"/>
                            <field name="last_name" required="1" placeholder="Ej: Pérez"/>
                            <field name="function" string="Puesto"/>
                            <field name="parent_id" string="Cuenta" domain="[('is_company', '=', True), ('id', '!=', id)]" options="{'no_create': True}" placeholder="Selecciona una cuenta" context="{'form_view_ref': 'crm.view_partner_form_crm_company'}"/>
                        </group>
                        <group>
                            <field name="email" string="Correo electrónico" placeholder="nombre@empresa.com"/>
                            <field name="phone" string="Teléfono del trabajo" placeholder="Ej: 985123456"/>
                            <field name="mobile" string="Teléfono móvil" placeholder="Ej: 612345678"/>
                            <field name="preferred_contact_method"/>
                            <field name="tz" string="Zona horaria principal"/>
                        </group>
                    </group>

                    <group string="DIRECCIÓN" col="2">
                        <group>
                            <field name="available_location_ids" invisible="1"/>
                            <field name="location_id" string="Ubicación" domain="[('id', 'in', available_location_ids)]" options="{'no_create': True}" placeholder="Selecciona una ubicación"/>
                            <field name="street"
                                string="Calle"/>
                            <field name="street_number" string="Número"/>
                            <field name="street2" string="Portal / Piso / Oficina"/>
                            <field name="city" string="Ciudad"/>
                            <field name="zip" string="Código postal"/>
                            <field name="state_id" string="Estado o provincia" options="{'no_open': True, 'no_create': True}"/>
                            <field name="country_id" string="País o región" options="{'no_open': True, 'no_create': True}"/>
                            <field name="latitude" invisible="1"/>
                            <field name="longitude" invisible="1"/>
                            <button name="action_geocode_address" type="object" string="Actualizar" class="btn-secondary"/>
                        </group>
                        <group>
                            <field name="contact_map_html" widget="html" nolabel="1" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_partner_form_crm_company" model="ir.ui.view">
        <field name="name">res.partner.form.crm.company</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Cuenta" class="o_crm_partner_form o_crm_partner_company_form o_professional_clean">
                <sheet>
                    <field name="is_company" invisible="1"/>
                    <field name="type" invisible="1"/>

                    <!-- 1. Botón superior derecho (Nativo) -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_website" type="object" class="oe_stat_button" icon="fa-globe" invisible="not website">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sitio Web</span>
                            </div>
                        </button>
                    </div>

                    <!-- 2. KPIs superiores auto-ajustables -->
                    <div class="d-flex flex-wrap gap-2 mb-4 border-bottom pb-3">
                        <div class="bg-light border rounded px-3 py-2 text-center flex-grow-1" style="min-width: 120px;">
                            <div class="text-muted fw-bold mb-1">Casos activos</div>
                            <field name="kpi_ticket_active_count" nolabel="1" class="fw-bold fs-5 text-primary"/>
                        </div>
                        <div class="bg-light border rounded px-3 py-2 text-center flex-grow-1" style="min-width: 120px;">
                            <div class="text-muted fw-bold mb-1">Casos resueltos</div>
                            <field name="kpi_ticket_done_count" nolabel="1" class="fw-bold fs-5 text-success"/>
                        </div>
                        <div class="bg-light border rounded px-3 py-2 text-center flex-grow-1" style="min-width: 120px;">
                            <div class="text-muted fw-bold mb-1">Horas invertidas</div>
                            <field name="kpi_ticket_done_hours" nolabel="1" class="fw-bold fs-5"/>
                        </div>
                        <div class="bg-light border rounded px-3 py-2 text-center flex-grow-1" style="min-width: 120px;">
                            <div class="text-muted fw-bold mb-1">Dispositivos</div>
                            <field name="contract_devices_summary" nolabel="1" class="fw-bold fs-6"/>
                        </div>
                    </div>

                    <!-- 3. Cabecera principal (Inmune a los aplastamientos de las ventanas modales) -->
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title">
                        <label for="name" string="Nombre de cuenta"/>
                        <h1>
                            <field name="name" required="1" placeholder="Ej: DSI Soluciones Industriales"/>
                        </h1>
                        <group>
                            <field name="email" string="Correo electrónico" placeholder="nombre@empresa.com"/>
                            <field name="phone" string="Teléfono" placeholder="Ej: 628787560"/>
                        </group>
                    </div>

                    <notebook>
                        <page string="Resumen">
                            <!-- 4. Agrupaciones Nativas (Pintan las cajas de entrada correctamente) -->
                            <group>
                                <group string="Datos fiscales y generales">
                                    <field name="vat" string="CIF" placeholder="Ej: B12345678"/>
                                    <field name="trade_name" string="Marca Comercial" placeholder="Ej: DSI"/>
                                    <field name="website" string="Sitio web" placeholder="www.ejemplo.com"/>
                                </group>
                                <group string="Relación y contacto principal">
                                    <field name="parent_id" string="Cuenta primaria" domain="[('is_company', '=', True), ('id', '!=', id)]" placeholder="Cuenta primaria" context="{'form_view_ref': 'crm.view_partner_form_crm_company'}"/>
                                    <field name="relationship_type_id" string="Tipo de relación"/>
                                    <field name="main_contact_id" string="Contacto principal" domain="[('parent_id', '=', id), ('type', '=', 'contact')]" placeholder="Contacto principal"/>
                                </group>
                                <group string="Privacidad y LOPD">
                                    <field name="lopd_signed" string="LOPD firmada"/>
                                    <field name="lopd_document_id" string="Archivo LOPD" options="{'no_create': True, 'no_create_edit': True}" placeholder="Seleccionar archivo LOPD"/>
                                    <button name="action_import_lopd_document" type="object" string="Adjuntar archivo LOPD" class="btn btn-secondary"/>
                                </group>
                            </group>

                            <!-- Dirección y mapa -->
                            <group string="Dirección principal">
                                <group>
                                    <field name="available_location_ids" invisible="1"/>
                                    <field name="location_id" string="Ubicación" domain="[('id', 'in', available_location_ids)]" options="{'no_create': True}" placeholder="Selecciona una ubicación"/>
                                    <label for="street" string="Dirección"/>
                                    <div class="o_address_format">
                                        <field name="street" string="Calle" placeholder="Ej: C/ Asturias" class="o_address_street"/>
                                        <field name="street_number" string="Número" placeholder="Ej: 21" class="o_address_street"/>
                                        <field name="street2" string="Portal / Piso / Oficina" placeholder="Ej: Entresuelo B" class="o_address_street"/>
                                        <field name="city" string="Ciudad" placeholder="Ej: Oviedo" class="o_address_city"/>
                                        <field name="zip" string="Código postal" placeholder="Ej: 33001" class="o_address_zip"/>
                                        <field name="state_id" string="Estado o provincia" class="o_address_state" options="{'no_open': True, 'no_create': True}"/>
                                        <field name="country_id" string="País o región" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                                    </div>
                                    <button name="action_geocode_address" type="object" string="Actualizar" class="btn btn-secondary mt-2"/>
                                </group>
                                <group>
                                    <field name="map_html" widget="html" nolabel="1"/>
                                </group>
                            </group>

                            <!-- Contactos -->
                            <separator string="Contactos"/>
                            <field name="child_ids" mode="list,form" editable="bottom" domain="[('is_company', '=', False), ('type', '=', 'contact')]" context="{'default_parent_id': id, 'default_type': 'contact', 'default_is_company': False, 'form_view_ref': 'crm.view_partner_form_crm_person'}">
                                <list>
                                    <field name="name" string="Nombre completo"/>
                                    <field name="email" string="Correo electrónico"/>
                                    <field name="phone" string="Teléfono"/>
                                    <field name="mobile" string="Teléfono móvil"/>
                                </list>
                            </field>
                        </page>

                        <page string="Facturación">
                            <group col="2">
                                <group>
                                    <field name="billing_prepago" widget="boolean_toggle"/>
                                    <field name="billing_payment_method_id"/>
                                    <field name="billing_invoice_email"/>
                                    <field name="billing_sepa_signed" widget="boolean_toggle"/>
                                </group>
                                <group>
                                    <field name="billing_incidents_cobro"/>
                                    <field name="billing_default_pricelist"/>
                                </group>
                            </group>
                            <group invisible="not billing_sepa_signed" col="2">
                                <label for="billing_sepa_document_id" string="Documento SEPA"/>
                                <field name="billing_sepa_document_id"
                                    nolabel="1"
                                    invisible="not billing_sepa_signed"
                                    required="billing_sepa_signed"
                                    options="{'no_create': True, 'no_create_edit': True}"/>
                                <span class="o_form_label">&#160;</span>
                                <button name="action_import_sepa_document"
                                        type="object"
                                        invisible="not billing_sepa_signed"
                                        string="Adjuntar documento SEPA"
                                        class="btn-primary"/>
                            </group>
                            <group string="Cuentas bancarias">
                                <field name="bank_ids" nolabel="1" context="{'default_partner_id': id}">
                                    <list editable="bottom">
                                        <field name="acc_number" string="Cuenta"/>
                                        <field name="bank_id" string="Banco"/>
                                        <field name="currency_id" string="Divisa"/>
                                        <field name="active" string="Activa"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page string="Contratos">
                            <group col="2">
                                <group string="Contratos principales" col="2" class="o_contracts_main_group">
                                    <label for="contract_it_bonus" string="Bono informática"/>
                                    <div>
                                        <field name="contract_it_bonus" widget="boolean_toggle" nolabel="1"/>
                                    </div>
                                    <label for="contract_total_it_maintenance" string="Mantenimiento total informática"/>
                                    <div>
                                        <field name="contract_total_it_maintenance" widget="boolean_toggle" nolabel="1"/>
                                    </div>
                                    <label for="contract_physical_centralita" string="Mantenimiento centralita física"/>
                                    <div>
                                        <field name="contract_physical_centralita" widget="boolean_toggle" nolabel="1"/>
                                    </div>
                                    <label for="contract_cloud_centralita" string="Mantenimiento centralita cloud"/>
                                    <div>
                                        <field name="contract_cloud_centralita" widget="boolean_toggle" nolabel="1"/>
                                    </div>
                                    <label for="contract_vpn" string="Mantenimiento VPN"/>
                                    <div>
                                        <field name="contract_vpn" widget="boolean_toggle" nolabel="1"/>
                                    </div>
                                    <label for="contract_acronis" string="Acronis"/>
                                    <div>
                                        <field name="contract_acronis" widget="boolean_toggle" nolabel="1"/>
                                    </div>
                                    <label for="contract_antivirus" string="Antivirus"/>
                                    <div>
                                        <field name="contract_antivirus" widget="boolean_toggle" nolabel="1"/>
                                    </div>
                                    <label for="contract_office365" string="Office 365"/>
                                    <div>
                                        <field name="contract_office365" widget="boolean_toggle" nolabel="1"/>
                                    </div>
                                    <group string="Licencias antivirus" invisible="not contract_antivirus" col="2" colspan="2" class="o_contract_devices_group">
                                        <label for="contract_antivirus_licenses" string="Nº licencias antivirus"/>
                                        <field name="contract_antivirus_licenses" nolabel="1"/>
                                    </group>
                                    <group string="Dispositivos incluidos" invisible="not contract_total_it_maintenance" col="2" colspan="2" class="o_contract_devices_group">
                                        <label for="contract_it_devices_laptops" string="Nº portátiles"/>
                                        <field name="contract_it_devices_laptops" nolabel="1"/>
                                        <label for="contract_it_devices_desktops" string="Nº sobremesa"/>
                                        <field name="contract_it_devices_desktops" nolabel="1"/>
                                        <label for="contract_it_devices_software" string="Nº SERVER"/>
                                        <field name="contract_it_devices_software" nolabel="1"/>
                                    </group>
                                </group>
                                <group string="Incidencias" col="2">
                                    <label for="contract_incidents_cobro" string="Incidencias cobro (contrato)"/>
                                    <div>
                                        <field name="contract_incidents_cobro" widget="boolean_toggle" nolabel="1"/>
                                    </div>
                                </group>
                            </group>
                            <group string="Contratos extra">
                                <field name="contract_extra_line_ids" nolabel="1" class="o_contract_extra_inline" context="{'default_partner_id': id}">
                                    <kanban create="false" delete="false" class="o_contract_extra_inline_kanban">
                                        <field name="option_id"/>
                                        <field name="enabled"/>
                                        <templates>
                                            <t t-name="card">
                                                <div class="o_contract_extra_inline_row">
                                                    <div class="o_contract_extra_inline_label">
                                                        <field name="option_id"/>
                                                    </div>
                                                    <div class="o_contract_extra_inline_toggle">
                                                        <field name="enabled" widget="boolean_toggle"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                            </group>
                        </page>

                        <page string="Activos y ubicaciones">
                            <group>
                                <field name="location_search" string="Buscar" placeholder="Buscar por ubicación o dirección..."/>
                                <field name="location_show_active_only" string="Mostrar activos"/>
                                <field name="location_detected_html" widget="html" nolabel="1" readonly="1"/>
                            </group>
                            <group string="Añadir ubicación nueva">
                                <field name="location_ids" nolabel="1" context="{'default_partner_id': id}">
                                    <list editable="bottom">
                                        <field name="name" string="Nombre ubicación"/>
                                        <field name="street" string="Calle"/>
                                        <field name="street_number" string="Nº"/>
                                        <field name="city" string="Ciudad"/>
                                        <field name="zip" string="CP"/>
                                        <field name="state_id" string="Provincia"/>
                                        <field name="country_id" string="País"/>
                                        <field name="active" string="Activa" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Servicio">
                            <group>
                                <group string="Casos activos">
                                    <field name="kpi_ticket_active_count" readonly="1" nolabel="1"/>
                                </group>
                                <group string="Casos resueltos">
                                    <field name="kpi_ticket_done_count" readonly="1" nolabel="1"/>
                                    <label for="kpi_ticket_done_hours" string="Horas invertidas"/>
                                    <field name="kpi_ticket_done_hours" readonly="1" nolabel="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Archivos">
                            <group>
                                <field name="notes" nolabel="1" placeholder="Añade notas o archivos aquí..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_partner_form_crm_unified" model="ir.ui.view">
        <field name="name">res.partner.form.crm.unified</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Partner"> class="o_crm_partner_form o_crm_partner_unified_form">
                <sheet>
                    <field name="is_company" invisible="1"/>
                    <group col="2">
                        <group>
                            <field name="name"/>
                            <field name="parent_id" domain="[('is_company', '=', True), ('id', '!=', id)]" context="{'form_view_ref': 'crm.view_partner_form_crm_company'}"/>
                            <field name="available_location_ids" invisible="1"/>
                            <field name="location_id" string="Ubicación" domain="[('id', 'in', available_location_ids)]" options="{'no_create': True}"/>
                            <field name="street"/>
                            <field name="street_number"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="zip"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_partner_tree_crm" model="ir.ui.view">
        <field name="name">res.partner.tree.crm</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Partners">
                <field name="name" string="Nombre"/>
                <field name="phone" string="Teléfono" widget="phone" optional="show"/>
                <field name="email" string="Email" widget="email" optional="show"/>
                <field name="parent_id" string="Cuenta" optional="show"/>
                <field name="user_id" string="Comercial" widget="many2one_avatar_user" optional="hide"/>
                <field name="active" string="Estado" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_partner_search_crm" model="ir.ui.view">
        <field name="name">res.partner.search.crm</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Buscar Partners">
                <field name="name"/>
                <field name="parent_id" string="Cuenta"/>
                <filter string="Empresas" name="companies" domain="[('is_company', '=', True)]"/>
                <filter string="Contactos" name="contacts" domain="[('is_company', '=', False), ('type', '=', 'contact')]"/>
                <separator/>
                <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactivos" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Mi equipo" name="my_team" domain="[('user_id', '=', uid)]"/>
            </search>
        </field>
    </record>

    <record id="action_partner_customer_all_companies" model="ir.actions.act_window">
        <field name="name">Cuentas</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_company', '=', True)]</field>
        <field name="context">{
            'default_is_company': True,
            'search_default_active': 1
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_partner_tree_crm')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_partner_form_crm_company')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('base.res_partner_kanban_view')})]"/>
        <field name="search_view_id" ref="view_partner_search_crm"/>
    </record>

    <record id="contacts.action_contacts" model="ir.actions.act_window">
        <field name="name">Cuentas</field>
        <field name="path">contacts</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_partner_search_crm"/>
        <field name="domain">[('is_company', '=', True)]</field>
        <field name="context">{
            'default_is_company': True,
            'search_default_active': 1
        }</field>
    </record>

    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="name">Clientes</field>
        <field name="action" ref="contacts.action_contacts"/>
    </record>

    <record id="contacts.action_contacts_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="0"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="base.res_partner_kanban_view"/>
        <field name="act_window_id" ref="contacts.action_contacts"/>
    </record>

    <record id="contacts.action_contacts_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_partner_tree_crm"/>
        <field name="act_window_id" ref="contacts.action_contacts"/>
    </record>

    <record id="contacts.action_contacts_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_partner_form_crm_company"/>
        <field name="act_window_id" ref="contacts.action_contacts"/>
    </record>

    <record id="action_partner_customer_all_persons" model="ir.actions.act_window">
        <field name="name">Contactos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_company', '=', False), ('type', '=', 'contact')]</field>
        <field name="context">{
            'default_is_company': False,
            'default_type': 'contact',
            'search_default_active': 1
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_partner_tree_crm')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_partner_form_crm_person')})]"/>
        <field name="search_view_id" ref="view_partner_search_crm"/>
    </record>

    <record id="contacts.res_partner_menu_contacts" model="ir.ui.menu">
        <field name="name">Cuentas</field>
        <field name="parent_id" ref="contacts.menu_contacts"/>
        <field name="action" ref="contacts.action_contacts"/>
    </record>

    <menuitem id="menu_crm_all_contacts"
        name="Contactos"
        parent="contacts.menu_contacts"
        action="action_partner_customer_all_persons"
        sequence="3"/>

    <record id="view_crm_contract_option_tree" model="ir.ui.view">
        <field name="name">crm.contract.option.tree</field>
        <field name="model">crm.contract.option</field>
        <field name="arch" type="xml">
            <list string="Contratos" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_crm_contract_option_form" model="ir.ui.view">
        <field name="name">crm.contract.option.form</field>
        <field name="model">crm.contract.option</field>
        <field name="arch" type="xml">
            <form string="Contrato">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_contract_options" model="ir.actions.act_window">
        <field name="name">Contratos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">crm.contract.option</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_crm_contract_option_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_crm_contract_option_form')})]"/>
        <field name="context">{'default_active': True}</field>
    </record>

    <menuitem id="menu_crm_contract_options"
        name="Contratos"
        parent="contacts.menu_contacts"
        action="action_crm_contract_options"
        sequence="4"/>

    <record id="view_attachment_form_lopd_import" model="ir.ui.view">
        <field name="name">ir.attachment.form.lopd.import</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <form string="Importar Documento LOPD">
                <sheet>
                    <group>
                        <field name="name" string="Nombre"/>
                        <field name="type" string="Tipo"/>
                        <field name="datas" string="Contenido del archivo (base64)" filename="name"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Guardar" special="save" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attachment_lopd_import" model="ir.actions.act_window">
        <field name="name">Importar Documento LOPD</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_attachment_form_lopd_import"/>
        <field name="target">new</field>
    </record>

    <record id="view_partner_simple_form_crm_universal" model="ir.ui.view">
        <field name="name">res.partner.simple.form.crm.universal</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_simple_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']/field[@name='parent_id']" position="replace">
                <field name="parent_id"
                    widget="res_partner_many2one"
                    placeholder="Cuenta..."
                    domain="[('is_company', '=', True), ('id', '!=', id)]"
                    context="{'default_is_company': True, 'form_view_ref': 'crm.view_partner_form_crm_company'}"
                    invisible="is_company"/>
            </xpath>
            <xpath expr="//h1/field[@id='company']" position="replace">
                <field id="company" name="name" default_focus="1" placeholder="Ej: DSI Soluciones Industriales" invisible="not is_company" required="type == 'contact' and is_company"/>
            </xpath>
            <xpath expr="//h1/field[@id='individual']" position="replace">
                <div invisible="is_company" class="o_row" style="gap: 8px; width: 100%;">
                    <field name="first_name" placeholder="Nombre" required="not is_company"/>
                    <field name="last_name" placeholder="Apellidos" required="not is_company"/>
                </div>
            </xpath>
            <xpath expr="//group" position="replace">
                <group>
                    <field name="trade_name" invisible="not is_company" placeholder="Marca comercial"/>
                    <field name="function" string="Puesto" invisible="is_company"/>
                    <field name="email" widget="email" context="{'gravatar_image': True}"/>
                    <field name="phone" widget="phone" options="{'enable_sms': false}"/>
                    <field name="mobile" widget="phone" options="{'enable_sms': false}"/>
                    <field name="preferred_contact_method" invisible="is_company"/>
                    <field name="vat" invisible="not is_company" placeholder="CIF/NIF"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_partner_address_form_crm_universal" model="ir.ui.view">
        <field name="name">res.partner.address.form.crm.universal</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_address_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='o_address_format']/field[@name='street']" position="after">
                <field name="street_number" placeholder="Nº" class="o_address_street"/>
            </xpath>
            <xpath expr="//group[1]/group[1]" position="inside">
                <field name="available_location_ids" invisible="1"/>
                <field name="location_id" string="Ubicación" domain="[('id', 'in', available_location_ids)]" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>