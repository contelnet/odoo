<odoo>
    <data>
        <record model="ir.ui.view" id="outlook_sync_form">
            <field name="name">outlook_sync_form</field>
            <field name="model">odoo_outlook.outlook_sync</field>
            <field name="priority" eval="0"/>
            <field name="arch" type="xml">
                <form class="oe_form_configuration">
                    <sheet>
                        <div class="mb-4">
                            <h1>Outlook Helpdesk</h1>
                            <div class="text-muted" style="font-size: 14px;">
                                Configuración recomendada para producción: usar Outlook para abrir el correo y crear tickets en Odoo desde el panel del complemento.
                            </div>
                        </div>

                        <group col="1">
                            <group string="Datos que debes introducir en el complemento">
                                <field name="server" readonly="1"/>
                                <field name="database" readonly="1"/>
                            </group>
                            <group string="Diagnóstico recomendado antes de instalar en producción">
                                <field name="setup_status_html" widget="html" nolabel="1" readonly="1"/>
                            </group>
                        </group>

                        <separator string="Pasos recomendados"/>
                        <div class="text-muted" style="font-size: 14px; line-height: 1.6;">
                            <ol style="padding-left: 18px; margin-bottom: 0;">
                                <li>Comprueba que la URL del servidor es accesible desde el equipo Windows donde está Outlook.</li>
                                <li>Descarga e instala el complemento con Outlook cerrado.</li>
                                <li>Abre Outlook, configura servidor, base de datos, usuario y contraseña.</li>
                                <li>Abre un correo y usa el botón <strong>Crear ticket</strong> desde el panel de Odoo.</li>
                            </ol>
                        </div>

                        <footer>
                            <button name="action_test_outlook_setup" string="Probar configuración" type="object" class="btn-secondary"/>
                            <button name="action_open_health_check" string="Abrir chequeo técnico" type="object" class="btn-secondary"/>
                            <button name="download_outlook" string="Descargar complemento de Outlook" type="object" class="btn-primary"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="outlook_sync_action">
            <field name="name">Outlook Helpdesk</field>
            <field name="res_model">odoo_outlook.outlook_sync</field>
            <field name="view_mode">form</field>
        </record>


        <menuitem id="sync_top_menu" name="Outlook Helpdesk" sequence="1000" action="outlook_sync_action"/>
    </data>
</odoo>