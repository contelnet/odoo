<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="product_view_template_catalog_common_inherit" model="ir.ui.view">
        <field name="name">product.template.catalog.common.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <div name="options" position="inside">
                <span class="d-inline-flex" invisible="type == 'combo'">
                    <field name="ticket_active" />
                    <label for="ticket_active" string="Tickets" />
                </span>
            </div>
        </field>
    </record>

    <record id="product_view_template_catalog_form" model="ir.ui.view">
        <field name="name">product.template.catalog.form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form string="Producto" class="product-catalog-form">
                <header>
                    <button
                        string="Guardar"
                        special="save"
                        class="btn btn-primary product-catalog-save-btn hmgt-product-catalog-save-btn"
                        icon="fa-save"
                    />

                </header>
                <sheet name="product_form">
                    <field name="active" invisible="1" />
                    <field name="company_id" invisible="1" />
                    <field name="currency_id" invisible="1" />
                    <field name="cost_currency_id" invisible="1" />
                    <field name="uom_name" invisible="1" />
                    <field name="ticket_active" invisible="1" />
                    <field name="sale_ok" invisible="1" />
                    <field name="purchase_ok" invisible="1" />
                    <field name="type" invisible="1" />
                    <field name="stock_initial_locked" invisible="1" />
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active" />

                    <field
                        name="image_1920"
                        widget="image"
                        class="oe_avatar"
                        options="{'convert_to_webp': True, 'preview_image': 'image_128'}"
                    />

                    <div class="oe_title">
                        <label for="name" string="Nombre" />
                        <h1>
                            <field name="name" placeholder="Nombre del producto" />
                        </h1>
                        <div class="mt-3">
                            <label for="default_code" string="Part Number" class="d-block" />
                            <field name="default_code" placeholder="Internal reference / part number" />
                        </div>
                    </div>

                    <group>
                        <group string="Identificación y uso">
                            <field name="product_business_type" widget="radio" />
                            <field name="product_notes" placeholder="Descripción opcional" />
                            <field name="product_mode" widget="radio" />
                        </group>
                        <group string="Inventario y trazabilidad">
                            <field name="has_imei" />
                            <field
                                name="imei_number"
                                placeholder="Introduce el IMEI"
                                invisible="not has_imei"
                                required="has_imei"
                            />
                            <field name="has_serial_number" />
                            <field
                                name="serial_number_input"
                                placeholder="Introduce el numero de serie"
                                invisible="not has_serial_number"
                            />
                            <field
                                name="serial_number_count"
                                string="Seriales guardados"
                                readonly="1"
                                invisible="not has_serial_number"
                            />
                            <div
                                class="o_form_label text-muted"
                                invisible="not has_serial_number"
                            >Al guardar, el número de serie se añade al listado de la pestaña Seriales.</div>
                            <div class="hmgt-product-stock-panel">
                                <div class="hmgt-product-stock-grid">
                                    <field name="stock_initial_qty" string="Stock Inicial" class="hmgt-stock-field-secondary" invisible="stock_initial_locked" help="Úsalo una sola vez para meter artículos que ya tienes en almacén sin comprarlos. Al guardar, se suma al stock actual y desaparece."/>
                                    <field name="stock_real_qty" string="Stock Actual" class="hmgt-stock-field-primary" readonly="1" help="Stock total disponible del producto."/>
                                    <field name="service_sales_count" string="Contador ventas" class="hmgt-stock-field-secondary" readonly="1" invisible="product_business_type not in ('service','software')" help="Total acumulado vendido para servicios y software confirmados."/>
                                </div>
                                <p class="text-muted mb-0 hmgt-stock-help-text" invisible="stock_initial_locked">El stock inicial se integra automáticamente en el stock actual al guardar.</p>
                            </div>
                        </group>
                    </group>

                    <group invisible="product_mode != 'pieces'">
                        <group string="Piezas y composición" colspan="2">
                            <field
                                name="piece_input"
                                placeholder="Escribe una pieza y guarda para añadirla"
                            />
                            <field
                                name="piece_product_id"
                                string="Producto existente"
                                domain="[('id', '!=', id)]"
                                options="{'no_open': True, 'no_create': True}"
                                placeholder="Busca un producto existente para añadirlo como pieza"
                            />
                            <field name="piece_ids" nolabel="1">
                                <list string="Piezas del producto" editable="bottom">
                                    <field name="name" string="Pieza" required="1"/>
                                    <field name="piece_product_id" string="Producto" optional="show" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="serial_number" string="N. serie" optional="show"/>
                                    <field name="price_unit" string="Compra"/>
                                    <field name="sale_price_unit" string="Venta"/>
                                    <field name="create_date" string="Fecha de alta" readonly="1" optional="show"/>
                                </list>
                            </field>
                        </group>
                    </group>

                    <group>
                        <group string="Compra y proveedor">
                            <!-- COMPRA -->
                            <field
                                name="standard_price"
                                string="Precio de compra"
                                widget="monetary"
                                options="{'currency_field': 'cost_currency_id', 'field_digits': True}"
                                groups="base.group_user"
                            />

                            <field
                                name="canon_amount"
                                widget="monetary"
                                options="{'currency_field': 'currency_id', 'field_digits': True}"
                            />

                            <field
                                name="supplier_partner_id"
                                placeholder="Selecciona una cuenta de proveedor"
                                options="{'no_create': False}"
                                groups="base.group_user"
                            />

                            <field
                                name="supplier_reference"
                                string="Enlace o referencia externa"
                                widget="text"
                                placeholder="Enlace, pedido web o cualquier referencia externa"
                                groups="base.group_user"
                            />
                        </group>

                        <group string="Venta">
                            <field
                                name="list_price"
                                string="Precio de venta"
                                widget="monetary"
                                options="{'currency_field': 'currency_id', 'field_digits': True}"
                            />

                        </group>
                    </group>

                    <notebook>
                        <page string="Ventas">
                            <group string="Ventas" class="hmgt-history-panel">
                                <field name="sale_history_html" widget="html" nolabel="1" />
                            </group>
                        </page>
                        <page string="Compras" groups="base.group_user">
                            <group string="Compras" class="hmgt-history-panel">
                                <field name="purchase_history_html" widget="html" nolabel="1" />
                            </group>
                        </page>
                        <page string="Seriales" invisible="not has_serial_number">
                            <group string="Seriales del producto">
                                <field name="serial_number_ids" nolabel="1">
                                    <list string="Numeros de serie" delete="1">
                                        <field name="name" string="Numero de serie" />
                                        <field name="create_date" string="Fecha de alta" readonly="1" optional="show" />
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="product_view_template_catalog_form_history_tabs_fix" model="ir.ui.view">
        <field name="name">product.template.catalog.form.history.tabs.fix</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_view_template_catalog_form" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="replace">
                <notebook>
                    <page string="Ventas">
                        <group string="Ventas" class="hmgt-history-panel">
                            <field name="sale_history_html" widget="html" nolabel="1" />
                        </group>
                    </page>
                    <page string="Compras" groups="base.group_user">
                        <group string="Compras" class="hmgt-history-panel">
                            <field name="purchase_history_html" widget="html" nolabel="1" />
                        </group>
                    </page>
                    <page string="Seriales" invisible="not has_serial_number">
                        <group string="Seriales del producto">
                            <field name="serial_number_ids" nolabel="1">
                                <list string="Numeros de serie" delete="1">
                                    <field name="name" string="Numero de serie" />
                                    <field name="create_date" string="Fecha de alta" readonly="1" optional="show" />
                                </list>
                            </field>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

