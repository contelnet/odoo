<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="product_view_template_catalog_form_account" model="ir.ui.view">
        <field name="name">product.template.catalog.form.account</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_view_template_catalog_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <field name="supplier_taxes_id" invisible="1" groups="base.group_user"/>
                <field name="purchase_tax_amount" invisible="1" groups="base.group_user"/>
                <field name="purchase_total_with_canon" invisible="1" groups="base.group_user"/>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="taxes_id" invisible="1"/>
                <field name="sale_tax_amount" invisible="1"/>
                <field name="sale_total_with_canon" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
