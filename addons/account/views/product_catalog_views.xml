<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="product_view_template_catalog_form_account" model="ir.ui.view">
        <field name="name">product.template.catalog.form.account</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_view_template_catalog_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <field
                    name="supplier_taxes_id"
                    string="Impuestos de compra"
                    widget="many2many_tags"
                    options="{'no_create': False}"
                    context="{'default_type_tax_use': 'purchase'}"
                    groups="base.group_user"
                />
                <field
                    name="purchase_tax_amount"
                    string="Impuestos compra"
                    readonly="1"
                    widget="monetary"
                    options="{'currency_field': 'cost_currency_id', 'field_digits': True}"
                    groups="base.group_user"
                />
            </xpath>
            <xpath expr="//field[@name='canon_amount']" position="after">
                <field
                    name="purchase_total_with_canon"
                    string="Costo total"
                    readonly="1"
                    widget="monetary"
                    options="{'currency_field': 'cost_currency_id', 'field_digits': True}"
                    groups="base.group_user"
                />
            </xpath>
            <xpath expr="//field[@name='list_price']" position="after">
                <field
                    name="taxes_id"
                    string="Impuestos de venta"
                    widget="many2many_tags"
                    options="{'no_create': False}"
                    context="{'default_type_tax_use': 'sale'}"
                />
                <field
                    name="sale_tax_amount"
                    string="Impuestos venta"
                    readonly="1"
                    widget="monetary"
                    options="{'currency_field': 'currency_id', 'field_digits': True}"
                />
                <field
                    name="sale_total_with_canon"
                    string="Venta total"
                    readonly="1"
                    widget="monetary"
                    options="{'currency_field': 'currency_id', 'field_digits': True}"
                />
            </xpath>
        </field>
    </record>

</odoo>
