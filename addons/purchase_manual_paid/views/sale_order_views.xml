<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Añadimos el desplegable en la línea de venta + botón para selección múltiple -->
    <record id="view_order_form_inherit_serial" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.serial</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Lo ponemos justo después del nombre (descripción) del producto -->
            <xpath expr="//field[@name='order_line']//list//field[@name='name']" position="after">
                <field name="product_template_id" column_invisible="1"/>
                <field name="serial_id"
                       optional="show"
                       domain="[('product_id.product_tmpl_id', '=', product_template_id)]"
                       options="{'no_create': True, 'no_open': True}"/>
                <button name="action_open_multi_serial_wizard"
                        type="object"
                        icon="fa-barcode"
                        title="Seleccionar varios números de serie"
                        invisible="not product_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_search_inherit_serial" model="ir.ui.view">
        <field name="name">product.template.search.inherit.serial</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">['|', '|', ('name', 'ilike', self), ('default_code', 'ilike', self), ('template_serial_ids.name', 'ilike', self)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- 2. Búsqueda directa al pulsar Enter en PEDIDOS DE VENTA (Modo Fuerza Bruta) -->
    <record id="view_sales_order_filter_inherit_serial" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.serial</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='name']" position="replace">
                <field name="name" 
                       string="Pedido / Serial" 
                       filter_domain="['|', '|', '|', ('name', 'ilike', self), ('client_order_ref', 'ilike', self), ('partner_id', 'child_of', self), ('order_line.serial_id.name', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>
</odoo>