<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Formulario del Pedido (Dentro) -->
        <record id="view_purchase_order_form_inherit_paid_toggle" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.paid.toggle</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_order']" position="before">
                    <field name="is_manually_paid" widget="boolean_toggle"/>
                </xpath>
            </field>
        </record>

        <!-- 2. Lista de Pedidos (Fuera) - ¡Apuntando a la vista con KPIs! -->
        <record id="view_purchase_order_kpis_tree_inherit_paid_column" model="ir.ui.view">
            <field name="name">purchase.order.kpis.tree.inherit.paid.column</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="after">
                    <field name="is_manually_paid" widget="boolean_toggle" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Lo añadimos también a la lista general de Pedidos de Compra -->
        <record id="view_purchase_order_tree_inherit_paid_column_normal" model="ir.ui.view">
            <field name="name">purchase.order.tree.inherit.paid.column.normal</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_tree"/>
            <field name="arch" type="xml">
                <!-- Lo ponemos justo después del estado de facturación -->
                <xpath expr="//field[@name='invoice_status']" position="after">
                    <field name="is_manually_paid" widget="boolean_toggle" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- 3. Lista del menú "Pedidos de Compra" (La definitiva) -->
        <record id="view_purchase_order_view_tree_inherit_paid_column" model="ir.ui.view">
            <field name="name">purchase.order.view.tree.inherit.paid.column</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
            <field name="arch" type="xml">
                <!-- Lo ponemos justo después del estado de facturación igual que en la otra -->
                <xpath expr="//field[@name='invoice_status']" position="after">
                    <field name="is_manually_paid" widget="boolean_toggle" optional="show"/>
                </xpath>
            </field>
        </record>
        
        <!-- NUEVO RECORD: Añadimos la columna de números de serie en las líneas -->
        <record id="view_purchase_order_form_inherit_serial" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.serial</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Buscamos la lista de líneas de pedido y lo ponemos después de la descripción (name) -->
                <xpath expr="//field[@name='order_line']//list//field[@name='name']" position="after">
                    <field name="serial_numbers" optional="show" placeholder="Pega aquí los SN..."/>
                </xpath>
            </field>
        </record>

        <!-- NUEVO RECORD: Botón de guardado manual en la cabecera -->
        <record id="view_purchase_order_form_inherit_save_button" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.save</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Buscamos la cabecera donde están los botones de estado y lo metemos dentro -->
                <xpath expr="//header" position="inside">
                    <button name="action_force_save" type="object" string="Guardar Seriales" class="oe_highlight" icon="fa-save"/>
                </xpath>
            </field>
        </record>

        <!-- NUEVO RECORD: Búsqueda directa al pulsar Enter (Modo Fuerza Bruta) -->
        <record id="view_purchase_order_filter_inherit_serial" model="ir.ui.view">
            <field name="name">purchase.order.search.inherit.serial</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
            <!-- Le metemos prioridad 99 para que sea el último en cargar y nadie lo pise -->
            <field name="priority" eval="99"/>
            <field name="arch" type="xml">
                <!-- Reemplazamos el campo entero de raíz en vez de modificar sus atributos -->
                <xpath expr="//search/field[@name='name']" position="replace">
                    <field name="name" 
                           string="Pedido / Serial" 
                           filter_domain="['|', '|', '|', ('name', 'ilike', self), ('partner_ref', 'ilike', self), ('partner_id', 'child_of', self), ('order_line.serial_numbers', 'ilike', self)]"/>
                </xpath>
            </field>
        </record>

        <!-- NUEVO RECORD: Búsqueda directa en la vista de PEDIDOS DE COMPRA confirmados -->
        <record id="view_purchase_order_search_inherit_serial" model="ir.ui.view">
            <field name="name">purchase.order.search.inherit.serial</field>
            <field name="model">purchase.order</field>
            <!-- Aquí usamos el ID externo que acabas de cazar en la foto -->
            <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
            <field name="priority" eval="99"/>
            <field name="arch" type="xml">
                <xpath expr="//search/field[@name='name']" position="replace">
                    <field name="name" 
                           string="Pedido / Serial" 
                           filter_domain="['|', '|', '|', ('name', 'ilike', self), ('partner_ref', 'ilike', self), ('partner_id', 'child_of', self), ('order_line.serial_numbers', 'ilike', self)]"/>
                </xpath>
            </field>
        </record>



        <!-- =================================================================== -->
        <!-- NUEVO RECORD: Ocultar botón blanco inútil y añadir botón de Factura -->
        <!-- =================================================================== -->
        <record id="purchase_order_form_inherit_clean_buttons" model="ir.ui.view">
            <field name="name">purchase.order.form.clean.buttons</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                
                <!-- 1. Hacemos invisible el botón blanco (el que NO tiene la clase oe_highlight) -->
                <xpath expr="//header/button[@name='action_create_invoice'][not(contains(@class, 'oe_highlight'))]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- 2. Añadimos nuestro acceso directo a la factura al lado del botón principal -->
                <xpath expr="//header/button[@name='action_create_invoice'][contains(@class, 'oe_highlight')]" position="after">
                    <button name="action_view_invoice" 
                            type="object" 
                            string="Ir a factura de proveedor" 
                            class="btn-secondary" 
                            invisible="invoice_count == 0"/>
                </xpath>

            </field>
        </record>
        
        <!-- NUEVO RECORD: Forzar la vista rápida bonita al crear productos en Compras -->
        <record id="view_purchase_order_form_inherit_product_wizard" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.product.wizard</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Buscamos el campo del producto dentro de la tabla de líneas de compra -->
                <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="attributes">
                    <!-- Le inyectamos el form_view_ref para que cargue tu vista personalizada -->
                    <attribute name="context">{'partner_id': parent.partner_id, 'form_view_ref': 'product.product_view_form_normalized'}</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>