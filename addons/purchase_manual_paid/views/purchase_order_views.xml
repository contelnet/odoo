<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Formulario del Pedido (Dentro) -->
        <record id="view_purchase_order_form_inherit_paid_toggle" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.paid.toggle</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_order']" position="before">
                    <field name="is_manually_paid" widget="boolean_toggle"/>
                </xpath>
            </field>
        </record>

<!-- 2. Lista de Pedidos (Fuera) - ¡Apuntando a la vista con KPIs! -->
        <record id="view_purchase_order_kpis_tree_inherit_paid_column" model="ir.ui.view">
            <field name="name">purchase.order.kpis.tree.inherit.paid.column</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="after">
                    <field name="is_manually_paid" widget="boolean_toggle" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Lo añadimos también a la lista general de Pedidos de Compra -->
        <record id="view_purchase_order_tree_inherit_paid_column_normal" model="ir.ui.view">
            <field name="name">purchase.order.tree.inherit.paid.column.normal</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_tree"/>
            <field name="arch" type="xml">
                <!-- Lo ponemos justo después del estado de facturación -->
                <xpath expr="//field[@name='invoice_status']" position="after">
                    <field name="is_manually_paid" widget="boolean_toggle" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- 3. Lista del menú "Pedidos de Compra" (La definitiva) -->
        <record id="view_purchase_order_view_tree_inherit_paid_column" model="ir.ui.view">
            <field name="name">purchase.order.view.tree.inherit.paid.column</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
            <field name="arch" type="xml">
                <!-- Lo ponemos justo después del estado de facturación igual que en la otra -->
                <xpath expr="//field[@name='invoice_status']" position="after">
                    <field name="is_manually_paid" widget="boolean_toggle" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Tu record anterior del toggle de pagado estará por aquí arriba -->
        
        <!-- NUEVO RECORD: Añadimos la columna de números de serie en las líneas -->
        <record id="view_purchase_order_form_inherit_serial" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.serial</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Buscamos la lista de líneas de pedido y lo ponemos después de la descripción (name) -->
                <xpath expr="//field[@name='order_line']//list//field[@name='name']" position="after">
                    <field name="serial_numbers" optional="show" placeholder="Pega aquí los SN..."/>
                </xpath>
            </field>
        </record>

        <!-- NUEVO RECORD: Botón de guardado manual en la cabecera -->
        <record id="view_purchase_order_form_inherit_save_button" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit.save</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Buscamos la cabecera donde están los botones de estado y lo metemos dentro -->
                <xpath expr="//header" position="inside">
                    <button name="action_force_save" type="object" string="Guardar Seriales" class="oe_highlight" icon="fa-save"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>